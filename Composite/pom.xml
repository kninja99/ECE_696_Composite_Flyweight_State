<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.arizona.ece696</groupId>
    <artifactId>composite-ast</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Composite AST Arithmetic Evaluator</name>
    <description>
        Parser and evaluator for arithmetic expressions whose Abstract Syntax Tree
        is built with the Composite design pattern. ECE 696 assignment.
    </description>

    <properties>
        <!-- Compiled to Java 17 bytecode (an LTS) for broad Eclipse/JDK
             compatibility; builds fine on the installed JDK 26. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <surefire.version>3.2.5</surefire.version>
    </properties>

    <dependencies>
        <!-- JUnit 5 (Jupiter) aggregator: API + params + engine. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire 3.x is required to discover and run JUnit 5 tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- Lets `mvn exec:java` run the demo without extra configuration:
                 mvn compile exec:java -Dexec.mainClass=edu.arizona.ece696.ast.Main -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>edu.arizona.ece696.ast.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
